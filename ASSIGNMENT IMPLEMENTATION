# ============================================================
# FUNCTION 1: AUTHORIZATION CHECK
# ============================================================

def authorization_check():
    print("\n[PHASE 1] AUTHORIZATION AND SCOPE VERIFICATION")

    print("\nImportant:")
    print("This tool must only be used on localhost or")
    print("an explicitly authorized laboratory environment.")

    authorization = input("\nDo you have authorization? (yes/no): ").lower()

    if authorization != "yes":
        print("\n[ACCESS DENIED]")
        print("Assessment stopped. Authorization is required.")
        return False

    print("\n[AUTHORIZED]")
    print("Ethical assessment process can continue.")
    return True


# ============================================================
# FUNCTION 2: TARGET VALIDATION
# ============================================================

def validate_target(target):
    allowed_targets = [
        "127.0.0.1",
        "localhost"
    ]

    if target.lower() not in allowed_targets:
        print("\n[SECURITY NOTICE]")
        print("This academic implementation is restricted to localhost.")
        print("Use an isolated authorized lab environment.")

        return False

    return True


# ============================================================
# FUNCTION 3: RECONNAISSANCE
# ============================================================

def reconnaissance(target):

    print("\n" + "=" * 65)
    print("[PHASE 2] RECONNAISSANCE")
    print("=" * 65)

    print("\nTarget Information:")
    print("Target:", target)

    try:
        ip_address = socket.gethostbyname(target)

        print("Resolved IP Address:", ip_address)

        return {
            "target": target,
            "ip_address": ip_address,
            "status": "Success"
        }

    except socket.gaierror:

        print("Unable to resolve target.")

        return {
            "target": target,
            "ip_address": "Unknown",
            "status": "Failed"
        }


# ============================================================
# FUNCTION 4: SAFE SERVICE CHECK
# ============================================================

def service_scan(target):

    print("\n" + "=" * 65)
    print("[PHASE 3] AUTHORIZED SERVICE DISCOVERY")
    print("=" * 65)

    # Common ports only for localhost lab demonstration
    ports = {
        80: "HTTP",
        443: "HTTPS",
        5000: "Flask Development Server",
        8000: "Python HTTP Server",
        8080: "Web Application"
    }

    open_services = []

    for port, service in ports.items():

        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(1)

            result = sock.connect_ex((target, port))

            if result == 0:

                print(f"[OPEN] Port {port} - {service}")

                open_services.append({
                    "port": port,
                    "service": service,
                    "status": "Open"
                })

            else:
                print(f"[CLOSED] Port {port} - {service}")

            sock.close()

        except Exception as error:

            print(f"[ERROR] Port {port}: {error}")

    return open_services


# ============================================================
# FUNCTION 5: HTTP SECURITY HEADER CHECK
# ============================================================

def check_security_headers():

    print("\n" + "=" * 65)
    print("[PHASE 4] WEB SECURITY CONFIGURATION ASSESSMENT")
    print("=" * 65)

    url = "http://localhost:5000"

    required_headers = [
        "Content-Security-Policy",
        "X-Frame-Options",
        "X-Content-Type-Options"
    ]

    try:

        response = requests.get(url, timeout=3)

        print("\nTarget URL:", url)
        print("HTTP Status Code:", response.status_code)

        for header in required_headers:

            if header in response.headers:

                print(f"[PASS] {header} is present")

            else:

                print(f"[WARNING] {header} is missing")

                findings.append({
                    "title": f"Missing Security Header: {header}",
                    "severity": "Medium",
                    "impact": "The web application may have reduced browser security protection.",
                    "recommendation": f"Configure the {header} HTTP security header."
                })

    except requests.exceptions.ConnectionError:

        print("\n[INFO]")
        print("No web server detected on localhost:5000")
        print("Skipping HTTP security header assessment.")

    except Exception as error:

        print("Error:", error)


